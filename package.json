{
  "name": "american-hairline",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:stable": "next dev --webpack -H 127.0.0.1 -p 3000",
    "dev:clean": "lsof -ti:3000 | xargs kill -9 2>/dev/null; rm -rf .next/dev .next/cache && ulimit -n 8192 && npm run dev:stable",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx --max-warnings 20",
    "typecheck": "tsc --noEmit",
    "build:funnel": "node scripts/build-funnel-content.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "import-wp-posts": "node scripts/import-wp-posts.js",
    "sync-legacy-pages": "node scripts/sync-legacy-pages-to-cms.js",
    "sync-jsonld": "node scripts/sync-wordpress-jsonld-to-pages.js",
    "create-admin": "node scripts/create-admin-user.js",
    "import-wp-seo": "node scripts/import-wp-seo.js",
    "import-wp-pages-seo": "node scripts/import-wp-pages-seo.js",
    "audit-wp-featured-images": "npx tsx scripts/audit-wordpress-featured-images.ts",
    "migrate-featured-images:dry": "npx tsx scripts/migrate-featured-images.ts --dry-run",
    "migrate-featured-images": "npx tsx scripts/migrate-featured-images.ts",
    "migrate-featured-images:first-batch": "npm run audit-wp-featured-images && npm run migrate-featured-images -- --limit=20 --offset=0 --sync-meta-image",
    "reprocess-wp-posts:dry": "node --experimental-transform-types scripts/reprocess-wp-posts-from-html.ts --dry",
    "reprocess-wp-posts": "node --experimental-transform-types scripts/reprocess-wp-posts-from-html.ts",
    "payload:migrate": "node --experimental-transform-types src/scripts/run-payload-migrate.ts",
    "optimize:homepage-media": "node scripts/optimize-homepage-media.mjs",
    "optimize:homepage-media:dry": "DRY_RUN=1 node scripts/optimize-homepage-media.mjs",
    "upload:bangalore-media": "node scripts/upload-bangalore.mjs",
    "upload:bangalore-media:dry": "DRY_RUN=1 node scripts/upload-bangalore.mjs",
    "upload:clip-on-media": "node scripts/upload-clip-on.mjs",
    "upload:clip-on-media:dry": "DRY_RUN=1 node scripts/upload-clip-on.mjs"
  },
