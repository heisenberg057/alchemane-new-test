# =============================================================================
# American Hairline — environment template
# Local: copy to .env.local
# VPS:   copy to .env (docker compose reads .env automatically)
# Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Docker Compose Postgres (REQUIRED on VPS — used to build DATABASE_URL)
# URL-encode special characters in POSTGRES_PASSWORD (@ # % etc).
# -----------------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=americanhairline

# Prefer an explicit DATABASE_URL on VPS (required by docker-compose web service).
# Host MUST be `postgres` inside Compose. URL-encode special chars in the password
# (@ → %40, # → %23, % → %25). Example:
# DATABASE_URL=postgresql://admin:ENCODED_PASSWORD@postgres:5432/americanhairline
DATABASE_URL=postgresql://admin:change-me-strong-password@postgres:5432/americanhairline
# Local without Postgres: PAYLOAD_SKIP_DB=1  OR  npm run db:up

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth & security (REQUIRED in production)
# -----------------------------------------------------------------------------
PAYLOAD_SECRET=your-payload-secret-min-32-chars
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
# Must match public domain on VPS:
NEXTAUTH_URL=https://americanhairline.com
GDPR_TOKEN_SECRET=your-gdpr-token-secret-min-32-chars
REVALIDATION_SECRET=your-revalidation-secret-min-32-chars

# -----------------------------------------------------------------------------
# Public app URL (REQUIRED — baked into client + sitemap/OG/canonicals)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://americanhairline.com
NEXT_PUBLIC_API_URL=/api

# -----------------------------------------------------------------------------
# Cloudflare Turnstile (REQUIRED in production — forms will fail without it)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Cloudflare R2 (REQUIRED in production — homepage /media rewrite + CMS media)
# -----------------------------------------------------------------------------
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ahl-media
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-<id>.r2.dev

# Media CDN (Phase 1: absolute R2 URLs + prebuilt WebP; Phase 2: custom domain)
# NEXT_PUBLIC_MEDIA_CDN_URL=https://media.americanhairline.com
# Set to 1 after custom domain + Cloudflare Image Resizing are live:
# NEXT_PUBLIC_MEDIA_IMAGE_RESIZE=1
# Force absolute CDN URLs even in local/dev (optional):
# NEXT_PUBLIC_MEDIA_FORCE_ABSOLUTE=1

# -----------------------------------------------------------------------------
# Email (Resend) — REQUIRED in production (forms/GDPR emails fail closed without it)
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@americanhairline.com
# ADMIN_EMAIL is required in production (contact form notifications)
ADMIN_EMAIL=admin@americanhairline.com

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# -----------------------------------------------------------------------------
# Optional tooling
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=
GOOGLE_PAGESPEED_API_KEY=
BLOCKED_IPS=
